}

class Mercado{
    private String nome;
    private boolean estacionamento;//vazio = 0, cheio = 1
    private Produtos prod_mercado;

//Nome: Singleton
//Problema: a criação de outro mercado
//Solução: construtor privado e metódo estático que entrega sempre o memso objeto
//Consequências: o estado compartilha entre testes

    private static Mercado instancia;
    private Mercado(){}
    public static Mercado getInstance() {
        if (instancia == null) {
            instancia = new Mercado();
        }
        return instancia;
    }

//construtor(private por causa do Singleton)
    private Mercado(String nome, boolean estacionamento, Produtos prod_mercado){
        this.nome = nome;
        this.estacionamento = estacionamento;
        this.prod_mercado = prod_mercado;
    }
    
//getters
    public String getNome(){return nome;}
    public boolean getEstabelecimento(){return estacionamento;}
    public Produtos getProd_mercado(){return prod_mercado;}

//setter
    public void setProd_mercado(Produtos prod_mercado){
       this.prod_mercado = prod_mercado;
    }
}

class Produtos{
    private String nome;
    private double preco;
    private int quant_estoque;
    
//construtor (reaproveitando os setters)
    public Produtos(String nome, double preco, int quant_estoque){
        setNome(nome);
        setPreco(preco);
        setQuant_estoque(quant_estoque);
    }

//construtor 2 (sobrecarga)
//apenas a quantidade não irá pedir, sempre será 0
    public Produtos(String nome, double preco){
        this(nome, preco, 0);
    }

//getters
    public String getNome(){return nome;}
    public double getPreco(){return preco;}
    public int getQuant_estoque(){return quant_estoque;}

//setters
    public void setNome(String nome){
        this.nome = nome;
    }

    //encapsulamento
    //preço não pode ter valor negativo ou 0
    public void setPreco(double preco){
        if(preco <= 0){
            //exceção
            throw new IllegalArgumentException("\nErro! preço menor ou igual a 0!\n");
        }else{
            this.preco = preco;
        }
    }

    //encapsulamento
    //quantidade do estoque não pode ser negativo
    public void setQuant_estoque(int quant_estoque){
        if(quant_estoque < 0){
            //exceção
            throw new IllegalArgumentException("\nErro! Estoque negativo!\n");
        }else{
            this.quant_estoque = quant_estoque;
        }
    }
}

//Nome: Factory Method
//Problema: vários tipos de produtos
//Solução: uma classe que faça exclusivamente a função de criação
//Consequências: adiciona uma classe a masi no projeto

//Criar duas subclasses para poder usar o Factory Method
//Subclasse Produtos_Alimenticios
class Alimentos extends Produtos{
    public Alimentos(String nome, double preco, int quant_estoque){
        super(nome, preco, quant_estoque);
    }
}

//Subclasse Limpeza
class Limpeza extends Produtos{
    public Limpeza(String nome , double preco, int quant_estoque){
        super(nome, preco, quant_estoque);
    }
}

//Criar a classe Fabrica
class Fabrica_produto{
    public static Produtos criar(String tipo,String nome, double preco, int quant_estoque){

        if(tipo.equals("Alimento")){
            return new Alimentos(nome, preco, quant_estoque);
        }

        if(tipo.equals("Limpeza")){
            return new Limpeza(nome, preco, quant_estoque);
        }
        throw new IllegalArgumentException("\nTipo desconhecido!\n");

    }
}

