        produto_quantidade.add(new JLabel("Quantidade:"));

        produto_quantidade.add(campo_quantidade);
        janela.add(produto_quantidade);


    //criar o botão para salvar na main
        JPanel campo_botao = new JPanel();
        JButton botao_confirmar = new JButton("Salvar Produto");
        campo_botao.add(botao_confirmar);
        janela.add(campo_botao);

        campo_preco.getText();
        //só para deixar a janela visivel
        janela.setVisible(true);

    //código para fazer o botão funcionar
        botao_confirmar.addActionListener(new ActionListener(){
            public void actionPerformed(ActionEvent e){
                try{
                    //recebe os valores da tela
                    String tipo = (String) campo_tipo_produto.getSelectedItem();
                    String nome = campo_nome.getText();
                    double preco = Double.parseDouble(campo_preco.getText());
                    int quantidade = Integer.parseInt(campo_quantidade.getText());

                    //chama a Fábrica
                    Produtos novo_produto= Fabrica_produto.criar(tipo, nome, preco, quantidade);

                    //chama o Mercado
                    Mercado mercado = Mercado.getInstance();

