                    JOptionPane.showMessageDialog(janela, erro.getMessage(), "Erro de validação", JOptionPane.ERROR_MESSAGE);
                }catch (Exception erroDigita){
                    JOptionPane.showMessageDialog(janela, "Erro! Digite apenas números no 'preço' e 'quantidade'", "Erro de Digitação", JOptionPane.WARNING_MESSAGE);
                }
            }
        });
